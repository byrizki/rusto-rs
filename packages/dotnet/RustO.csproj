<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>RustO</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RustO</PackageId>
    <Version>0.1.0</Version>
    <Authors>RustO Contributors</Authors>
    <Description>RustO! - Pure Rust OCR library based on RapidOCR with PaddleOCR engine</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yourusername/rusto-rs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yourusername/rusto-rs</PackageProjectUrl>
    <PackageTags>OCR;TextRecognition;ComputerVision;Rust;PaddleOCR;MNN</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes\" />
    
    <!-- Model files as None to avoid compilation, with metadata for NuGet content -->
    <None Include="models\**\*.mnn" Pack="true" PackagePath="contentFiles\any\any\models\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <BuildAction>None</BuildAction>
    </None>
    <None Include="models\**\*.txt" Pack="true" PackagePath="contentFiles\any\any\models\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <BuildAction>None</BuildAction>
    </None>
    
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    
    <!-- Include MSBuild targets file for automatic model file copying -->
    <None Include="buildTransitive\RustO.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>

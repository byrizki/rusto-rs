<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>RustODotnet</id>
    <version>0.1.1</version>
    <authors>RustO Contributors</authors>
    <description>RustO! - Pure Rust OCR library based on RapidOCR with PaddleOCR engine</description>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/byrizki/rusto-rs</projectUrl>
    <repository type="git" url="https://github.com/byrizki/rusto-rs" />
    <tags>OCR TextRecognition ComputerVision Rust PaddleOCR MNN</tags>
    <contentFiles>
      <files include="any/any/models/*.mnn" buildAction="None" copyToOutput="true" flatten="false" />
      <files include="any/any/models/*.txt" buildAction="None" copyToOutput="true" flatten="false" />
    </contentFiles>
  </metadata>
</package>

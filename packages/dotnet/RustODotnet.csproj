<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>RustODotnet</RootNamespace>
    <AssemblyName>RustODotnet</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RustODotnet</PackageId>
    <Version>0.2.3</Version>
    <Authors>RustO Contributors</Authors>
    <Description>RustO! - Pure Rust OCR library based on RapidOCR with PaddleOCR engine</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/byrizki/rusto-rs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/byrizki/rusto-rs</PackageProjectUrl>
    <PackageTags>OCR;TextRecognition;ComputerVision;Rust;PaddleOCR;MNN</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="models\**" />
    <EmbeddedResource Remove="models\**" />
    <None Remove="models\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed by netstandard2.1; net6.0+ provides this from shared framework. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

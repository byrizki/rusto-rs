<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>RustODotnet</RootNamespace>
    <AssemblyName>RustODotnet</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RustODotnet</PackageId>
    <Version>0.1.4</Version>
    <Authors>RustO Contributors</Authors>
    <Description>RustO! - Pure Rust OCR library based on RapidOCR with PaddleOCR engine</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/byrizki/rusto-rs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/byrizki/rusto-rs</PackageProjectUrl>
    <PackageTags>OCR;TextRecognition;ComputerVision;Rust;PaddleOCR;MNN</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes\" />
    
    <!-- Model files packaged in content folder (not contentFiles to avoid compile) -->
    <None Include="models\**\*.mnn" Pack="true" PackagePath="content\models\">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="models\**\*.txt" Pack="true" PackagePath="content\models\">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    
    <!-- Include MSBuild targets file for automatic model file copying -->
    <None Include="buildTransitive\RustODotnet.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jest", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "unicorn/no-empty-file": "error",
    "eslint/max-lines": ["warn", { "max": 500, "skipComments": true }],
    "eslint/max-lines-per-function": ["warn", { "max": 150, "skipComments": true }]
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "jest": true
  },
  "ignorePatterns": ["lib/**", "node_modules/**", "android/**", "ios/**", "*.podspec"]
}

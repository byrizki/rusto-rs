{
  "name": "rusto-example",
  "version": "0.3.2",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "android:legacy": "react-native run-android --mode=debug --extra-params='-PnewArchEnabled=false'",
    "android:new-arch": "react-native run-android --mode=debug --extra-params='-PnewArchEnabled=true'",
    "ios": "react-native run-ios",
    "ios:legacy": "RCT_NEW_ARCH_ENABLED=0 pod install --project-directory=ios && react-native run-ios",
    "ios:new-arch": "RCT_NEW_ARCH_ENABLED=1 pod install --project-directory=ios && react-native run-ios",
    "build:android:legacy": "cd android && ./gradlew assembleDebug -PnewArchEnabled=false",
    "build:android:new-arch": "cd android && ./gradlew assembleDebug -PnewArchEnabled=true",
    "build:ios:legacy": "cd ios && RCT_NEW_ARCH_ENABLED=0 pod install && xcodebuild -workspace RustoExample.xcworkspace -scheme RustoExample -configuration Debug -sdk iphonesimulator CODE_SIGNING_ALLOWED=NO",
    "build:ios:new-arch": "cd ios && RCT_NEW_ARCH_ENABLED=1 pod install && xcodebuild -workspace RustoExample.xcworkspace -scheme RustoExample -configuration Debug -sdk iphonesimulator CODE_SIGNING_ALLOWED=NO",
    "test": "jest",
    "test:both-arch": "tsx scripts/test-both-arch.ts",
    "test:e2e:maestro": "maestro test .maestro/ocr-flow.yaml",
    "test:e2e:android": "bash scripts/run-android-e2e.sh",
    "test:e2e:ios": "bash scripts/run-ios-e2e.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rustors/react-native": "file:..",
    "react": "18.3.1",
    "react-native": "^0.76.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/metro-config": "^0.88.0",
    "@types/react": "^18.3.1",
    "@types/react-test-renderer": "18.3.0",
    "react-test-renderer": "18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

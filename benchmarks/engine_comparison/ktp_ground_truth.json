        "PHOVINSIDKI JAKARTA"
      ],
      "root_cause": "Tight DBNet detection bounding box shaves left vertical stroke of \"D\", causing it to appear as \"U\" or \"O\"."
    },
    {
      "field": "JAKARTA PUSAT",
      "ground_truth": "JAKARTA PUSAT",
      "typical_ocr_errors": [
        "JAKARTAPUSA",
        "JAKARTAI",
        "JAKARTAPUSAT"
      ],
      "root_cause": "Right edge boundary truncation shaves \"T\" in \"PUSAT\" or merges with line spacing."
    },
    {
      "field": "NIK",
      "ground_truth": "3217141102960006",
      "typical_ocr_errors": [
        "3217141102760006",
        "321714110276000b"
      ],
      "root_cause": "Character \"9\" has a shallow lower curve; with ink spread and tight box clipping, CTC decoder confuses \"9\" with \"7\"."
    },

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- CI patches RustOArtifactVersion from downloaded local package artifact. -->
    <PackageReference Include="RustODotnet" Version="0.2.4" />
    <PackageReference Include="RustODotnet.Models.PPOCRv6.Tiny" Version="$(RustOArtifactVersion)" />
  </ItemGroup>
</Project>
